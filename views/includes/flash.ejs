<% if (success && success.length) { %>
  <% success.forEach(message => { %>
    <div class="site-toast site-toast-success" role="status" data-toast>
      <span class="site-toast-icon"><i class="fa-solid fa-circle-check"></i></span>
      <span class="site-toast-message"><%= message %></span>
      <button type="button" class="site-toast-close" aria-label="Dismiss notification"><i class="fa-solid fa-xmark"></i></button>
    </div>
  <% }) %>
<% } %>
<% if (error && error.length) { %>
  <% error.forEach(message => { %>
    <div class="site-toast site-toast-error" role="alert" data-toast>
      <span class="site-toast-icon"><i class="fa-solid fa-circle-exclamation"></i></span>
      <span class="site-toast-message"><%= message %></span>
      <button type="button" class="site-toast-close" aria-label="Dismiss notification"><i class="fa-solid fa-xmark"></i></button>
    </div>
  <% }) %>
<% } %>
