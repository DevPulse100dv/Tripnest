<% layout('layouts/boilerplate') -%>

<section class="explore-header">
  <div>
    <p class="eyebrow">A little closer to somewhere wonderful</p>
    <h1>Find your next <span>getaway.</span></h1>
    <p class="explore-subtitle">Thoughtful places to stay, picked for the way you like to travel.</p>
  </div>
  <% if (accountType === "admin") { %><a class="btn btn-primary-action" href="/listings/new"><i class="fa-solid fa-plus"></i> Add a stay</a><% } %>
  <button class="saved-stays-filter" type="button" data-saved-filter aria-pressed="false"><i class="fa-regular fa-heart"></i> Saved stays <span data-favorite-count>0</span></button>
</section>
<span class="visually-hidden" data-favorite-status aria-live="polite"></span>
<p class="saved-filter-status" data-saved-filter-status aria-live="polite" hidden></p>

<form class="listing-search-mobile" action="/listings" method="get" role="search">
  <label for="listing-search">Search stays or destinations</label>
  <div class="listing-search-control">
    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
    <input id="listing-search" type="search" name="search" value="<%= search %>" placeholder="Try Bengaluru, beach, or coffee">
    <button class="btn btn-primary-action" type="submit">Search</button>
  </div>
</form>

<% if (search) { %>
  <div class="search-results-summary" role="status">
    <span><strong><%= allListings.length %></strong> <%= allListings.length === 1 ? "stay" : "stays" %> matching “<%= search %>”</span>
    <a href="/listings">Clear search</a>
  </div>
<% } %>

<section class="category-marquee" aria-label="Search stays by inspiration">
  <% const filters = [
    { icon: "fa-mountain-sun", text: "Mountains", query: "mountain" },
    { icon: "fa-city", text: "City stays", query: "Bengaluru" },
    { icon: "fa-mug-hot", text: "Coffee country", query: "coffee" },
    { icon: "fa-tree", text: "Forest escapes", query: "forest" },
    { icon: "fa-water", text: "Waterfront", query: "waterfront" },
    { icon: "fa-campground", text: "Camping", query: "camping" },
    { icon: "fa-landmark", text: "Heritage stays", query: "heritage" },
    { icon: "fa-umbrella-beach", text: "Beach stays", query: "beach" }
  ]; %>
  <div class="category-marquee-window">
    <div class="category-marquee-track">
      <% [false, true].forEach(isDuplicate => { %>
        <div class="category-marquee-group" <%= isDuplicate ? 'aria-hidden="true"' : '' %>>
        <% filters.forEach(filter => { %>
          <a class="category-item" href="/listings?search=<%= encodeURIComponent(filter.query) %>" <%= isDuplicate ? 'tabindex="-1"' : '' %>>
            <i class="fa-solid <%= filter.icon %>" aria-hidden="true"></i><span><%= filter.text %></span>
          </a>
        <% }) %>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<% if (allListings.length) { %>
  <form id="compare-selection-form" class="compare-selection" action="/compare" method="post" data-compare-form>
    <div class="compare-selection-copy">
      <strong>Make the choice that fits you</strong>
      <span>Select 2–4 stays to compare by your priorities.</span>
    </div>
    <span class="compare-count" data-compare-count>0 selected</span>
    <button class="btn btn-primary-action" type="submit" data-compare-submit disabled>Compare stays</button>
  </form>
  <section class="listing-grid" aria-label="Available stays">
    <% allListings.forEach(list => { %>
      <article class="listing-card" data-listing-card data-listing-id="<%= list._id %>">
        <div class="listing-image-wrap">
          <a href="/listings/<%= list._id %>" class="listing-image-link" tabindex="-1" aria-hidden="true"><img src="<%= list.image && list.image.url ? list.image.url : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=1000&q=85' %>" alt="" loading="lazy"></a>
          <% if (list.averageRating !== null) { %><span class="listing-rating-badge" aria-label="Rated <%= list.averageRating.toFixed(1) %> out of 5 from <%= list.reviewCount %> reviews"><i class="fa-solid fa-star"></i> <%= list.averageRating.toFixed(1) %> <small>(<%= list.reviewCount %>)</small></span><% } %>
          <button class="favorite-button" type="button" data-favorite-id="<%= list._id %>" data-favorite-title="<%= list.title %>" aria-label="Save <%= list.title %>" aria-pressed="false"><i class="fa-regular fa-heart" aria-hidden="true"></i></button>
          <label class="compare-check"><input type="checkbox" name="listingIds" value="<%= list._id %>" form="compare-selection-form" data-compare-checkbox aria-label="Select <%= list.title %> to compare"><span>Compare</span></label>
        </div>
        <div class="listing-meta">
          <div class="listing-title-row">
            <h2><a class="listing-title-link" href="/listings/<%= list._id %>"><%= list.location %>, <%= list.country %></a></h2>
          </div>
          <p class="listing-name"><%= list.title %></p>
          <p class="listing-description"><%= list.description %></p>
          <p class="listing-price"><strong>&#8377; <%= Number(list.price || 0).toLocaleString("en-IN") %></strong> <span>/ night</span></p>
        </div>
      </article>
    <% }) %>
  </section>
<% } else { %>
  <section class="empty-state">
    <div class="empty-icon"><i class="fa-solid fa-house-chimney-window"></i></div>
    <h2>Your next favourite stay starts here</h2>
    <% if (search) { %>
      <p>No stays match “<%= search %>”. Try another destination or search term.</p>
      <a class="btn btn-primary-action" href="/listings">Browse all stays</a>
    <% } else { %>
      <p>There aren't any stays just yet. TripNest’s administrator can add the first curated stay.</p>
      <% if (accountType === "admin") { %><a class="btn btn-primary-action" href="/listings/new">Add a stay</a><% } %>
    <% } %>
</section>
<% } %>
