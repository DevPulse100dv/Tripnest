<% layout('layouts/boilerplate') -%>
<% const reviewCount = List.reviews.length; %>
<% const averageRating = reviewCount ? List.reviews.reduce((total, review) => total + review.ratings, 0) / reviewCount : null; %>

<main class="listing-detail-page">
  <section class="listing-overview" aria-labelledby="listing-title">
    <header class="listing-overview-heading">
      <p class="eyebrow">Your next stay</p>
      <h1 id="listing-title"><%= List.title %></h1>
      <p class="detail-location"><i class="fa-solid fa-location-dot"></i> <%= List.location %>, <%= List.country %></p>
    </header>
    <div class="listing-overview-grid">
      <img src="<%= List.image && List.image.url ? List.image.url : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=1400&q=85' %>" class="detail-image" alt="<%= List.title %>">
      <div class="detail-card">
        <p class="listing-host-line"><i class="fa-solid fa-circle-check"></i> Stay information maintained by <strong>TripNest</strong></p>
        <p class="detail-description"><%= List.description %></p>
        <p class="listing-detail-price"><strong>&#8377; <%= Number(List.price || 0).toLocaleString("en-IN") %></strong> <span>/ night</span></p>
        <% if (averageRating !== null) { %>
          <p class="review-summary listing-detail-rating"><i class="fa-solid fa-star"></i><strong><%= averageRating.toFixed(1) %></strong><span><%= reviewCount %> <%= reviewCount === 1 ? "review" : "reviews" %></span></p>
        <% } else { %><p class="listing-no-rating">No guest reviews yet</p><% } %>
        <% if (currUser && accountType === "admin") { %>
          <div class="butn">
            <a class="btn btn-outline-secondary" href="/listings/<%= List._id %>/edit">Edit stay</a>
            <form method="post" action="/listings/<%= List._id %>?_method=DELETE"><button class="btn btn-outline-danger" type="submit">Delete stay</button></form>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <section class="local-experiences" id="local-experiences" aria-labelledby="local-experiences-heading">
    <div class="local-experience-heading">
      <div>
        <p class="eyebrow">Go beyond the usual route</p>
        <h2 id="local-experiences-heading">Local experiences nearby</h2>
        <p>Experiences submitted for this stay and approved by TripNest.</p>
      </div>
      <% if (currUser && accountType === "guide") { %>
        <a class="btn btn-outline-secondary" href="/guide-experiences/new?listingId=<%= List._id %>"><i class="fa-solid fa-compass"></i> Offer an experience here</a>
      <% } %>
    </div>

    <% if (localExperiences.length) { %>
      <div class="local-experience-grid">
        <% localExperiences.forEach(experience => { %>
          <article class="local-experience-card">
            <div class="local-experience-card-heading">
              <div class="local-guide-avatar"><i class="fa-solid fa-person-hiking"></i></div>
              <div><span class="local-experience-area"><i class="fa-solid fa-location-dot"></i> <%= experience.area %></span><h3><%= experience.title %></h3><p>Hosted by <strong><%= experience.guide?.username || "Local guide" %></strong></p></div>
            </div>
            <div class="guide-check-badges">
              <span><i class="fa-solid fa-circle-check"></i> Profile reviewed by TripNest</span>
              <% if (experience.identityChecked) { %><span><i class="fa-solid fa-id-card"></i> Identity checked by TripNest</span><% } %>
              <% if (experience.credentialChecked && experience.credentialType) { %><span><i class="fa-solid fa-certificate"></i> <%= experience.credentialType %> checked</span><% } %>
            </div>
            <p class="local-experience-description"><%= experience.description %></p>
            <dl class="local-experience-facts">
              <div><dt>Price</dt><dd><strong>&#8377;<%= Number(experience.price).toLocaleString("en-IN") %></strong> / person</dd></div>
              <div><dt>Duration</dt><dd><%= experience.durationHours %> hours</dd></div>
              <div><dt>Languages</dt><dd><%= experience.languages.join(", ") %></dd></div>
              <div><dt>Includes</dt><dd><%= experience.includes || "Confirm with your guide" %></dd></div>
            </dl>
            <% if (currUser && accountType === "traveler" && !currUser._id.equals(experience.guide?._id)) { %>
              <div class="local-guide-contact">
                <a class="local-guide-phone" href="tel:<%= experience.contactPhone.replace(/[^+0-9]/g, '') %>"><i class="fa-solid fa-phone"></i> <%= experience.contactPhone %></a>
                <form action="/guide-experiences/<%= experience._id %>/requests" method="post">
                  <label for="guide-request-<%= experience._id %>">Ask about this experience</label>
                  <textarea class="form-control" id="guide-request-<%= experience._id %>" name="message" rows="3" minlength="10" maxlength="1000" placeholder="Ask about dates, meeting point, or what to bring" required></textarea>
                  <button class="btn btn-primary-action btn-sm" type="submit">Send contact request</button>
                </form>
              </div>
            <% } else if (!currUser) { %>
              <div class="local-guide-login-note"><i class="fa-solid fa-lock"></i> <a href="/login">Log in</a> to see guide contact details and send a request.</div>
            <% } else { %>
              <p class="local-guide-login-note">This is your experience. Manage enquiries from your <a href="/guide-experiences/mine">guide dashboard</a>.</p>
            <% } %>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="local-experiences-empty"><i class="fa-regular fa-compass"></i><span>No approved local guide experiences are listed for this stay yet. Guide submissions appear here after TripNest review.</span></div>
    <% } %>
  </section>

  <section class="listing-reviews" aria-labelledby="reviews-heading">
    <div class="review-section-heading">
      <div><p class="eyebrow">Guest feedback</p><h2 id="reviews-heading">Reviews</h2></div>
      <% if (averageRating !== null) { %><p class="review-summary"><i class="fa-solid fa-star"></i><strong><%= averageRating.toFixed(1) %></strong><span>from <%= reviewCount %> <%= reviewCount === 1 ? "review" : "reviews" %></span></p><% } else { %><p class="listing-no-rating">Be the first to review this stay</p><% } %>
    </div>

    <% if (currUser && accountType === "traveler") { %>
      <form method="post" class="review-form needs-validation" action="/listings/<%= List._id %>/reviews" novalidate>
        <label for="rating">Your rating</label>
        <fieldset class="starability-slot">
          <% for (let i = 1; i <= 5; i++) { %>
            <input type="radio" id="rate<%= i %>" name="review[ratings]" value="<%= i %>" required>
            <label for="rate<%= i %>" title="<%= ['Terrible', 'Not good', 'Average', 'Very good', 'Amazing'][i - 1] %>"><%= i %> star<%= i > 1 ? 's' : '' %></label>
          <% } %>
        </fieldset>
        <label for="comment">Share a few details about your stay</label>
        <textarea name="review[comment]" id="comment" class="form-control" rows="4" maxlength="1000" placeholder="What should future guests know?" required></textarea>
        <button class="btn btn-primary-action" type="submit">Post review</button>
      </form>
    <% } %>

    <% if (reviewCount) { %>
      <div class="review-grid">
        <% List.reviews.forEach(review => { %>
          <article class="review-card">
            <div class="review-card-heading"><h3 class="review-author">@<%= review.author.username %></h3><span class="review-card-rating"><i class="fa-solid fa-star"></i> <%= review.ratings %>.0</span></div>
            <p class="starability-result" data-rating="<%= review.ratings %>"></p>
            <p><%= review.comment %></p>
            <% if (currUser && review.author._id.equals(currUser._id)) { %>
              <form method="post" action="/listings/<%= List._id %>/reviews/<%= review._id %>?_method=DELETE"><button class="btn btn-sm btn-outline-secondary" type="submit">Delete review</button></form>
            <% } %>
          </article>
        <% }); %>
      </div>
    <% } else if (!currUser) { %>
      <p class="reviews-empty">There are no reviews yet.</p>
    <% } %>
  </section>
</main>
